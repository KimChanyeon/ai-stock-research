# =============================================
# 배포용 환경변수 템플릿
# cp .env.example .env  후 값 채워서 사용
# =============================================

# ── 도메인 (SSL) ──────────────────────────────
DOMAIN=yourdomain.com

# ── Google Gemini API ─────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── MySQL ─────────────────────────────────────
MYSQL_ROOT_PASSWORD=변경필수_루트_패스워드
MYSQL_DATABASE=app
MYSQL_USER=appuser
MYSQL_PASSWORD=변경필수_앱_패스워드

# ── Gemini 모델 (선택) ────────────────────────
# GEMINI_MODEL=gemini/gemini-2.0-flash
# GEMINI_SEARCH_MODEL=gemini-2.0-flash
