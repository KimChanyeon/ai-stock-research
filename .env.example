# =============================================
# 이 파일을 복사해서 .env 로 만들어 사용하세요
# cp .env.example .env
# =============================================

# Google Gemini API Key (필수)
GOOGLE_API_KEY=your_google_api_key_here

# MySQL (기본값으로도 동작, 운영 배포 시 반드시 변경)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app
MYSQL_USER=appuser
MYSQL_PASSWORD=apppass
