# =============================================
# AI Service 로컬 실행용 환경변수
# cp .env.example .env
# =============================================

# Google Gemini API Key (필수)
GOOGLE_API_KEY=your_google_api_key_here

# Gemini 모델 설정 (선택, 기본값 사용 권장)
# GEMINI_MODEL=gemini/gemini-3.1-flash-lite          # crewAI LLM용 (provider/model 형식)
# GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite          # Google Search grounding용

# MySQL (Docker: docker compose up mysql redis -d 후 사용)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=app
DB_USER=appuser
DB_PASSWORD=apppass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
