# =============================================
# AI Service 로컬 실행용 환경변수
# cp .env.example .env
# =============================================

# Google Gemini API Key (필수)
GOOGLE_API_KEY=your_google_api_key_here

# MySQL (Docker: docker compose up mysql redis -d 후 사용)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=app
DB_USER=appuser
DB_PASSWORD=apppass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
